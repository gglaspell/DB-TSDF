<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>db_tsdf</name>
  <version>1.1.0</version>
  <description>DB-TSDF: Directional Bitmask-based Truncated Signed Distance Fields for Efficient Volumetric Mapping </description>
  <maintainer email="jemaealv@upo.es">Jose E. Maese</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build and exec dependencies -->
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend> 
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>std_srvs</depend>
  <depend>libpcl-all-dev</depend>
  <depend>eigen</depend>
  <depend>libvtk9-dev</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>libssl-dev</depend>
  <depend>libomp-dev</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>zip</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <depend>boost</depend>


  <!-- System dependencies -->
  <exec_depend>python3-yaml</exec_depend>
  <!-- Only required by georeference_launch.py; DB-TSDF itself remains usable
       with an externally supplied map -> odom transform. -->
  <exec_depend>robot_localization</exec_depend>

  <!-- Testing dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_test</test_depend>
  <test_depend>rosbag2_py</test_depend>
  <test_depend>tf2_msgs</test_depend>

  <!-- Export build type -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
